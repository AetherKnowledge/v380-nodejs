{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "es2022",
		"lib": ["es2022"],
		"types": ["node"],
		"strict": true,
		"allowJs": true,
		"noImplicitAny": false,
		"sourceMap": true,
		"rootDir": "src",
		"paths": {
			"typebase": ["./src/types/typebase.d.ts"]
		},
		"outDir": "build",
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"incremental": false
	},
	"exclude": [
		"node_modules",
		"**/*.spec.ts",
		"**/*.test.ts"
	],
	"include": [
		"src/**/*.ts"
	]
}
