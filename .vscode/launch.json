{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch TypeScript app",
			"runtimeArgs": ["--require", "ts-node/register"],
			"program": "${workspaceFolder}/src/app.ts",
			"cwd": "${workspaceFolder}",
			"skipFiles": ["<node_internals>/**"],
			"console": "integratedTerminal"
		},
		{
			"type": "node",
			"request": "attach",
			"name": "Attach to npm run dev2",
			"port": 7321,
			"restart": true,
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
