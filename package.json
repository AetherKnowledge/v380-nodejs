{
  "name": "v380-nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "ts-node src/app.ts",
    "vlc": "node scripts/vlc.js",
    "test": "node --test test/*.test.js",
    "dev": "node --watch --require ts-node/register src/app.ts",
    "dev2": "node --watch --inspect=7321 --require ts-node/register src/app.ts",
    "lint": "eslint src",
    "build": "tsc",
    "prebuild:linux": "npm run typecheck",
    "build:linux": "bun build src/app.ts --compile --target=bun-linux-x64 --outfile dist/v380-linux-x64",
    "typecheck": "tsc --noEmit",
    "tsc": "tsc"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "eslint": "^10.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "typebase": "^1.0.1"
  }
}
